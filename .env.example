# Database
DATABASE_URL=postgresql://vsl_user:vsl_password@localhost:5432/vsl_bridge

# JWT
JWT_SECRET=your-32-character-secret-here-min
REFRESH_TOKEN_SECRET=your-32-char-refresh-secret-here

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7881

# Redis
REDIS_URL=redis://localhost:6379

# STT Provider
STT_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key

# TTS Provider
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your-elevenlabs-key

# Recognition model
# mock = random development classifier, spoter = demo_model/best_epoch_8
RECOGNITION_CLASSIFIER=spoter
RECOGNITION_MODEL_PATH=demo_model/best_epoch_8
RECOGNITION_LABELS_PATH=demo_model/gloss.csv

# Client
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000
